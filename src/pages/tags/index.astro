---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const allTags = Array.from(new Set(posts.flatMap(post => post.data.tags || []))).sort();
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`Tags | ${SITE_TITLE}`} description="Browse all security research tags on PWNFUZZ LABS." />
</head>
<body>
  <div class="wrapper">
    <Header />
    
    <section>
      <h2>Tags Archive</h2>
      <p>Browse finding categories and security writeups.</p>
      
      <ul>
        {allTags.map((tag) => {
          const count = posts.filter(p => (p.data.tags || []).includes(tag)).length;
          return (
            <li>
              <a href={`/tags/${tag}/`}>{tag}</a> ({count})
            </li>
          );
        })}
      </ul>
    </section>
    
    <Footer />
  </div>
</body>
</html>