---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${title} | PWNFUZZ LABS`} description={description} pubDate={pubDate} updatedDate={updatedDate} />
  </head>

  <body>
    <div class="wrapper">
      <Header />
      
      <section>
        <h1>{title}</h1>
        <p><small>{author ? `By ${author} on ` : ''}<FormattedDate date={pubDate} /></small></p>
        
        {updatedDate && (
          <p><small>Last updated on <FormattedDate date={updatedDate} /></small></p>
        )}
        
        <hr />
        
        <slot />
      </section>

      <Footer />
    </div>
  </body>
</html>
